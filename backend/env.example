# Copie este arquivo para `.env` e preencha. O `.env` está no .gitignore.
# Nenhum valor real deve voltar para cá.

# --- Credenciais da aplicação criada em dashboard.pluggy.ai ---
# Obrigatórias apenas quando FINANCAS_MODO=online.
PLUGGY_CLIENT_ID=<seu-client-id>
PLUGGY_CLIENT_SECRET=<seu-client-secret>

# --- Modo de execução ---
# offline (padrão): lê fixtures em JSON do disco, não toca a rede.
# online: chama a API real da Pluggy.
FINANCAS_MODO=offline

# Host da API. Só altere para apontar para um mock local.
PLUGGY_API_URL=https://api.pluggy.ai

# Caminho do banco DuckDB. Contém dado financeiro real: fica fora do git.
FINANCAS_BANCO=dados/financas.duckdb

# Regras de negócio configuráveis (fatura de cartão, contas próprias, frescor).
FINANCAS_REGRAS=config/regras.toml

# Diretório com as fixtures usadas no modo offline.
FINANCAS_FIXTURES=tests/fixtures/pluggy

# Rede: timeout por requisição em segundos e tentativas em falha transitória.
FINANCAS_TIMEOUT=30
FINANCAS_TENTATIVAS=3
